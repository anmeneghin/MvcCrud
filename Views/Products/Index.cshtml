@model IEnumerable<MvcCrud.Models.Product>

@{
    ViewData["Title"] = "Produtos";

}

<h1>Produtos</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Criar Novo</a>
</p>

<table class="table table-striped">
    <thead>
        <tr><th>Nome</th><th>Preço</th><th>Descrição</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Description</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>